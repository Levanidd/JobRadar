{
  "name": "jobradar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply job-scout --local && wrangler dev --port 43142 --ip 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "typecheck:admin": "npm --prefix admin run typecheck",
    "test": "npm run typecheck && npm run typecheck:admin && vitest run",
    "eval": "tsx scripts/eval.ts",
    "build": "npm --prefix admin ci && npm --prefix admin run build",
    "admin:dev": "npm --prefix admin run dev",
    "db:migrate:local": "wrangler d1 migrations apply job-scout --local",
    "db:migrate:remote": "wrangler d1 migrations apply job-scout --remote",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.13.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
